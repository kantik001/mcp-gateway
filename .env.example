PORT=8080
GRPC_PORT=8081
DATABASE_URL=postgres://gateway:gateway@localhost:5432/mcp_gateway?sslmode=disable
LOG_LEVEL=info
CONFIG_PATH=config/servers.yaml
HEALTH_CHECK_INTERVAL=30s
TOOL_CALL_TIMEOUT=30s
API_KEY=
DEFAULT_TENANT=default
# Leave empty to disable OTLP export (noop tracer). Compose sets http://jaeger:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=mcp-gateway
# Set to true to force a no-op tracer even when an OTLP endpoint is set
# OTEL_SDK_DISABLED=true
